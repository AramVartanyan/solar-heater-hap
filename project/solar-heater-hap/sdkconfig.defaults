CONFIG_IDF_TARGET="esp32s3"

# Firmware version: single source of truth (app descriptor, HomeKit Firmware
# Revision and the OTA version check all read this value).
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.1.0"

# Waveshare ESP32-S3-Zero: ESP32-S3FH4R2, 4 MB flash (QIO), 2 MB PSRAM (not used yet)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Partitions (4 MB, two 1600 KB OTA slots, HomeKit factory_nvs / nvs_keys, history 64 KB)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_hap.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Console on the USB-C port (built-in USB Serial/JTAG): log and `idf.py flash monitor`
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# CPU / compiler
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Task watchdog stays enabled: the control task must never stall silently.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# FreeRTOS timer task (button callbacks run there): default 2048 B overflowed on one ESP_LOGI;
# the callbacks now only queue events, the margin stays for other timer callbacks.
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3072

# LWIP (HomeKit needs several concurrent controller sockets)
CONFIG_LWIP_MAX_SOCKETS=20
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_MAX_ACTIVE_TCP=12
CONFIG_LWIP_MAX_LISTENING_TCP=12
CONFIG_LWIP_UDP_RECVMBOX_SIZE=10
# (the station takes the name Solar-xxxxxx from sh_net; this one is only the default of lwIP)
CONFIG_LWIP_LOCAL_HOSTNAME="solar-heater"
CONFIG_LWIP_DHCPS=y

# SNTP (sh_clock): pool.ntp.org at every connection to the router, then every 12 h
CONFIG_LWIP_SNTP_UPDATE_DELAY=43200000

# OTA (general-ota); server certificates come from the mbedTLS bundle below
CONFIG_GENERAL_OTA_URL="https://raw.githubusercontent.com/AramVartanyan/otafw/master/solheat1.bin"

# mbedTLS (certificate bundle is required by general-ota)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# captive-wifi 0.4.0: the name "Solar-xxxxxx" (base MAC) — the setup SoftAP, the access point of
# nEt -> AP, the host name and mDNS; without a stored network the portal closes and
# the radio goes off after 15 min without a client; access point only for nEt -> AP (sh_net)
CONFIG_CAPTIVE_WIFI_AP_SSID_PREFIX="Solar"
CONFIG_CAPTIVE_WIFI_PORTAL_IDLE_MIN=15
CONFIG_CAPTIVE_WIFI_AP_ONLY=y

# HomeKit SDK (sh_hap): the pages of the web interface (17 handlers, sh_web) are registered on
# the server of HAP next to its 8 URIs; browsers and the controllers (iPhone, home hubs) share its
# sockets (CONFIG_LWIP_MAX_SOCKETS above)
CONFIG_HAP_HTTP_MAX_URI_HANDLERS=28
CONFIG_HAP_HTTP_MAX_OPEN_SOCKETS=12

# mDNS (Solar-xxxxxx.local: sh_net without HomeKit, esp-homekit-sdk with it): on the station only
# (not on the own access point), no console CLI — the console component is not built
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
CONFIG_MDNS_PREDEF_NETIF_AP=n
CONFIG_MDNS_PREDEF_NETIF_ETH=n
