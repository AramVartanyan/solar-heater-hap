menu "Device Settings"

    menu "GPIO pins"

        config SH_PIN_T_COL
            int "DS18B20 collector (1-Wire)"
            default 1
        config SH_PIN_T_TANK
            int "DS18B20 tank (1-Wire)"
            default 2
        config SH_PIN_RELAY
            int "Pump relay (active high, transistor driver)"
            default 4
        config SH_PIN_TM1637_CLK
            int "TM1637 CLK"
            default 5
        config SH_PIN_TM1637_DIO
            int "TM1637 DIO"
            default 6
        config SH_PIN_BTN_MENU
            int "Button 1 (menu)"
            default 7
        config SH_PIN_BTN_MINUS
            int "Button 2 (-)"
            default 8
        config SH_PIN_BTN_PLUS
            int "Button 3 (+)"
            default 9
        config SH_PIN_LED
            int "Onboard WS2812 RGB LED"
            default 21

    endmenu

    menu "Control"

        config SH_MEASURE_PERIOD_S
            int "Temperature measurement period (s)"
            range 5 60
            default 10
            help
                Both sensors are measured this often, in their own task, independently of the
                1 s control loop. No averaging.

        config SH_DT_ON_K
            int "Switch-on difference, collector - tank (K)"
            range 3 20
            default 6
            help
                The pump starts when the collector is at least this much warmer than the tank.

        config SH_DT_OFF_K
            int "Switch-off difference, collector - tank (K)"
            range 1 15
            default 4
            help
                The pump stops when the difference falls to this value. Must be lower than the
                switch-on difference (checked at compile time).

        config SH_MIN_RUN_MIN
            int "Minimum run time (min)"
            range 1 10
            default 3
            help
                The difference can stop the pump only after it has run this long. The
                protections ignore it.

        config SH_MIN_OFF_MIN
            int "Minimum off time (min)"
            range 0 10
            default 2
            help
                The difference can start the pump only after it has been off this long
                (0 = no minimum). The collector protection ignores it.

        config SH_TANK_MAX_C
            int "Tank Tmax (degC)"
            range 30 85
            default 70
            help
                Normal charging stops at this tank temperature and is allowed again 2 K below
                it. The collector protection may charge above it, up to the fixed 95 degC
                emergency ceiling.

        config SH_COL_MIN_C
            int "Minimum collector temperature (degC)"
            range 10 80
            default 25
            help
                The difference does not start the pump while the collector is below this
                temperature. A running pump is not stopped by it.

        config SH_COL_PROTECT_C
            int "Collector protection (degC)"
            range 70 160
            default 110
            help
                The pump starts at once at this collector temperature, also above Tmax, and
                stops 2 K below it after the minimum run time. Values above 115 degC are
                limited to 115 degC (fixed in this version: default boiling point and
                collector maximum).

    endmenu

    config SH_INTERNAL_PULLUPS
        bool "Internal pull-ups on the 1-Wire and TM1637 lines (development prototype)"
        default y
        select ONEWIRE_INTERNAL_PULLUP
        help
            On the development prototype the external pull-up resistors are not fitted yet,
            so the internal ones (~45 kOhm) are enabled. Turn this off once the external
            4.7 kOhm (DS18B20) and 10 kOhm (TM1637) resistors are on the board.

    config SH_NET_RESET_HOLD_S
        int "Wi-Fi reset: hold the menu button (s)"
        range 3 7
        default 5
        help
            Releasing the menu button after holding it at least this long (and less than the
            factory reset time) erases the stored Wi-Fi network and restarts the device into
            the setup portal. 3 - 7 s, so it never overlaps the factory reset (8 - 12 s).

    config SH_FACTORY_RESET_HOLD_S
        int "Factory reset: hold the menu button (s)"
        range 8 12
        default 9
        help
            Holding the menu button this long erases everything (HomeKit pairings, device
            settings and the Wi-Fi network) and restarts the device; it starts while the
            button is still held.

    config SH_LED_BRIGHTNESS
        int "Status LED brightness (%)"
        range 1 100
        default 20
        help
            20 % chosen on the hardware (25 % was already bright enough, doc/firmware.md).

    config SH_HOSTNAME
        string "Network hostname"
        default "solar-heater"

endmenu
